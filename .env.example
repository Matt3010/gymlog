# gymlog settings. Copy to .env and fill in; the Pi keeps its own .env, never
# committed. An empty value means "not set": the default applies.

# --- Database ------------------------------------------------------------------------
# Required by docker compose. Letters and digits only (it goes inside a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Logins --------------------------------------------------------------------------
# Signs the access tokens. Without it, everyone signs in again at each restart:
#   openssl rand -hex 32
JWT_SECRET=

# Whether anyone can make an account from the login page. "false" closes it;
# users can still be made from the command line (below).
ALLOW_SIGNUP=true

# --- Web ------------------------------------------------------------------------------
# nginx on the host's loopback, for the Cloudflare Tunnel (tcgwatch uses 8090).
WEB_PORT=8091

# Users from the command line too (useful with ALLOW_SIGNUP=false):
#   docker compose exec -it api node_modules/.bin/tsx src/cli/users.ts create <username>
#   docker compose exec -it api node_modules/.bin/tsx src/cli/users.ts password <username>

# --- Only outside Docker (local tries) --------------------------------------------------
# Compose sets these itself; set them only when running `pnpm --filter @gymlog/backend dev`.
# DATABASE_URL=postgres://gymlog:<password>@localhost:5432/gymlog
# API_PORT=3000
# API_HOST=127.0.0.1
# INSECURE_COOKIE=1      # the app over plain http on localhost
