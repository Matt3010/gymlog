{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/ui.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": null
  },
  "tempDirName": ".stryker-tmp/ui",
  "cleanTempDir": "always",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "src/components/**/*.svelte",
    "src/App.svelte"
  ],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral",
      "Regex"
    ]
  }
}
