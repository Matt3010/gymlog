{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "La PWA di gymlog: schede, allenamenti e pesi, dal telefono.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "mutate": "stryker run && stryker run stryker.ui.config.json"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "~3.2.7",
    "jsdom": "^30.1.1",
    "lucide": "^1.49.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  }
}
